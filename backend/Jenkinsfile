pipeline {

    agent any

    environment {
        DOCKERHUB_USER = 'haroldbg'
        IMAGE_BACKEND = 'task-movil-api'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '📥 Checkout del repositorio desde rama hu-05-dev...'
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/hu-05-dev"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/camilo28k/programacion-movil-2025-b-g1.git'
                    ]],
                    extensions: [
                        [$class: 'CloneOption', timeout: 30],
                        [$class: 'CheckoutOption', timeout: 30]
                    ]
                ])

                sh 'cd backend && ls -la'
            }
        }

        stage('Load Secrets & Generate .env') {
            steps {
                echo '🔐 Cargando credenciales desde Jenkins y generando .env...'

            withCredentials([
                string(credentialsId: 'pg-user', variable: 'POSTGRES_USER'),
                string(credentialsId: 'pg-pass', variable: 'POSTGRES_PASSWORD'),
                string(credentialsId: 'pg-db', variable: 'POSTGRES_DB'),
                string(credentialsId: 'email-pass', variable: 'EMAIL_PASSWORD'),
                string(credentialsId: 'jwt-secret', variable: 'JWT_SECRET')
            ]) {

                sh '''
                    cd backend

                    echo "POSTGRES_USER=$POSTGRES_USER" > .env
                    echo "POSTGRES_PASSWORD=$POSTGRES_PASSWORD" >> .env
                    echo "POSTGRES_DB=$POSTGRES_DB" >> .env

                    echo "EMAIL_HOST=smtp.gmail.com" >> .env
                    echo "EMAIL_PORT=587" >> .env
                    echo "EMAIL_SECURE=false" >> .env
                    echo "EMAIL_USER=haroldcamilobarreragiraldo3@gmail.com" >> .env
                    echo "EMAIL_PASSWORD=$EMAIL_PASSWORD" >> .env
                    echo "EMAIL_FROM_NAME=Nexo Innovación" >> .env
                    echo "EMAIL_FROM_ADDRESS=no-reply@nexo.com" >> .env

                    echo "JWT_SECRET=$JWT_SECRET" >> .env
                    echo "JWT_EXPIRATION_TIME=3600s" >> .env

                    # AHORA Prisma puede conectarse a db, porque Jenkins está en la red nexo-network
                    echo "DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB?schema=public" >> .env

                    echo "📝 Archivo .env generado correctamente en backend/"
                '''
            }
        }
    }

        stage('Database Reset & Migrations') {
            steps {
                echo '🧹 Reiniciando base de datos y aplicando migraciones...'
                sh '''
                    cd backend
                    npm install
                    npm run db:reset
                '''
            }
        }

        stage('Build & Push Backend Image') {
            steps {
                echo '⚙️ Construyendo y subiendo imagen del backend a DockerHub...'

                sh '''
                    cd backend
                    docker build -t $DOCKERHUB_USER/$IMAGE_BACKEND:latest .
                '''

                withCredentials([string(credentialsId: 'dockerhub-token', variable: 'DOCKERHUB_PASS')]) {
                    sh '''
                        echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin
                        docker push $DOCKERHUB_USER/$IMAGE_BACKEND:latest
                    '''
                }
            }
        }

        stage('Deploy Updated Stack') {
            steps {
                echo '🚀 Desplegando stack actualizado (Postgres + Backend)...'
                sh '''
                    cd backend
                    docker compose down || true
                    docker compose up -d --build
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completado exitosamente.'
        }
        failure {
            echo '❌ Error en el pipeline. Revisa los logs.'
        }
    }
}
