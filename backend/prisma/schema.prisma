// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Role {
  id           String        @id @default(uuid())
  name         String        @unique
  userAccounts UserAccount[]
}

model Person {
  id          String       @id @default(uuid())
  first_names String
  last_names  String
  email       String       @unique
  phone       String?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  userAccount UserAccount?
}

model UserAccount {
  id                String   @id @default(uuid())
  username          String   @unique
  password_hash     String
  status            UserStatus @default(PENDING)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  person_id         String   @unique
  person            Person   @relation(fields: [person_id], references: [id])
  role_id           String
  role              Role     @relation(fields: [role_id], references: [id])
  companies         Company[]
  verificationToken VerificationToken?
}

model Category {
  id         String     @id @default(uuid())
  name       String
  url        String
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  companies  Company[]
}

model Company {
  id               String      @id @default(uuid())
  name             String
  description      String?
  url              String
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  owner_account_id String
  owner_account    UserAccount @relation(fields: [owner_account_id], references: [id])
  category_id      String?
  category         Category?   @relation(fields: [category_id], references: [id])
  products         Product[]
}

model Product {
  id               String     @id @default(uuid())
  title            String
  description      String?
  price            Decimal    @db.Decimal(10, 2)
  is_promotion     Boolean    @default(false)
  promotion_price  Decimal?   @db.Decimal(10, 2)
  url              String?
  company_id       String
  company          Company    @relation(fields: [company_id], references: [id])
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
}




model VerificationToken {
  id                String   @id @default(uuid())
  token             String
  expires_at        DateTime
  created_at        DateTime @default(now())
  user_account_id   String   @unique
  userAccount       UserAccount @relation(fields: [user_account_id], references: [id])
}
